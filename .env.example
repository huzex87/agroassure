PORT=3001

# Application connection (Nigeria-resident in production).
DATABASE_URL=postgres://agroassure:agroassure@localhost:5432/agroassure

# The public verification surface logs in separately, as a role that holds
# SELECT on public_certificate_view and nothing else. Adverse data is then
# unreachable from that module even if a query there were written carelessly.
# Create it once:
#   CREATE USER agroassure_public WITH PASSWORD '...';
#   GRANT public_verify_role TO agroassure_public;
PUBLIC_VERIFY_DATABASE_URL=postgres://agroassure_public:change-me@localhost:5432/agroassure

# Bearer tokens. Replace with the institution's OIDC provider in production.
AUTH_JWT_SECRET=change-me-in-production

# Evidence store. Local write-once directory in development; an S3-compatible
# bucket with object-lock in compliance mode in production.
EVIDENCE_STORE_DIR=./evidence-store

# What a certificate QR code points at.
PUBLIC_VERIFY_BASE_URL=https://verify.agroassure.ng
PUBLIC_VERIFY_RATE_PER_MINUTE=60

# Set either to "off" to run that sweep from cron instead of in-process.
# PROJECTOR_SWEEP=off
# ESCALATION_SWEEP=off
