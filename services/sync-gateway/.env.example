PORT=3001

# Application connection (Nigeria-resident in production).
DATABASE_URL=postgres://agroassure:agroassure@localhost:5432/agroassure

# The public verification surface logs in separately, as a role that holds
# SELECT on public_certificate_view and nothing else. Adverse data is then
# unreachable from that module even if a query there were written carelessly.
# Create it once:
#   CREATE USER agroassure_public WITH PASSWORD '...';
#   GRANT public_verify_role TO agroassure_public;
PUBLIC_VERIFY_DATABASE_URL=postgres://agroassure_public:change-me@localhost:5432/agroassure

# Bearer tokens. Replace with the institution's OIDC provider in production.
AUTH_JWT_SECRET=change-me-in-production

# Evidence store. Local write-once directory in development; an S3-compatible
# bucket with object-lock in compliance mode in production.
EVIDENCE_STORE_DIR=./evidence-store

# What a certificate QR code points at.
PUBLIC_VERIFY_BASE_URL=https://verify.agroassure.ng
PUBLIC_VERIFY_RATE_PER_MINUTE=60

# Set either to "off" to run that sweep from cron instead of in-process.
# PROJECTOR_SWEEP=off
# ESCALATION_SWEEP=off

# Inspectors' phones. An administrator invites an inspector from the console;
# the inspector gets a one-time code by email and SMS and types it into the app.
# DEVICE_TOKEN_SECRET signs the phone's session (32+ characters). In
# development it falls back to AUTH_JWT_SECRET when unset.
# DEVICE_TOKEN_SECRET=
# INVITE_TTL_HOURS=72
# FIELD_APP_DOWNLOAD_URL=https://example.org/agroassure.apk

# Where invite codes are sent from. "log" writes them to this service's log,
# which is the development default; a pilot defaults to "none" and the console
# shows each code instead.
# EMAIL_PROVIDER=resend        # resend | sendgrid | log | none
# EMAIL_API_KEY=
# EMAIL_FROM="AgroAssure <no-reply@example.gov.ng>"
# SMS_PROVIDER=termii          # termii | africastalking | twilio | log | none
# SMS_API_KEY=
# SMS_SENDER_ID=AgroAssure
# SMS_ACCOUNT=                 # Africa's Talking username, or Twilio account SID
# SMS_CHANNEL=dnd              # Termii route; dnd reaches do-not-disturb numbers
# SMS_DEFAULT_COUNTRY_CODE=234

# Console sign-in by emailed link: staff type their work email and get a
# one-time link. Needs a real EMAIL_PROVIDER. CONSOLE_URL is where the console
# lives (the link points there); CONSOLE_SESSION_SECRET (32+ characters) signs
# console sessions. With these set, a pilot needs no OIDC identity provider.
# CONSOLE_URL=https://console.example.gov.ng
# CONSOLE_SESSION_SECRET=

# Letting people ask to join. Off by default: administrators invite their own
# staff, which is one form and one code. Set to "on" to let anyone register —
# inspectors in the phone app, office staff on the console's Request access
# page — and prove their email and phone with a code sent to each. Nobody gets
# in until an administrator approves them and chooses their role. Even when on,
# it is only open when both EMAIL_PROVIDER and SMS_PROVIDER are real (or "log").
# SELF_REGISTRATION=off

# The first administrator. A new deployment has nobody who can approve anyone,
# and with email sign-in the demo accounts' inboxes do not exist. On every
# start the gateway makes sure this email is a national administrator, adding
# the state if it is missing. It only fills in what is absent; it never removes
# or downgrades anyone, and leaves a suspended account suspended.
# FIRST_ADMIN_EMAIL=you@agency.gov.ng
# FIRST_ADMIN_NAME="Your Name"
# FIRST_ADMIN_STATE="Katsina State"     # FIRST_ADMIN_STATE_CODE=KT to choose the code
