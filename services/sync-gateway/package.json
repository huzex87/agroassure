{
  "name": "@agroassure/sync-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "AgroAssure application tier: sync gateway (device-signed event ingest, evidence, pull, bootstrap), projections, regulator console API, certificate service, escalation worker, and the isolated public verification surface.",
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "start:dev": "ts-node-dev --respawn src/main.ts",
    "test": "vitest run",
    "worker:escalate": "node dist/cli/escalate.js",
    "token:mint": "node dist/cli/mint-token.js",
    "projections:rebuild": "node dist/cli/rebuild-projections.js",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@agroassure/domain": "workspace:*",
    "@aws-sdk/client-s3": "^3.1124.0",
    "@nestjs/common": "^10.4.1",
    "@nestjs/core": "^10.4.1",
    "@nestjs/platform-express": "^10.4.1",
    "@noble/hashes": "^1.4.0",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^4.1.0",
    "pg": "^8.12.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@agroassure/field-core": "workspace:*",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "@types/qrcode": "^1.5.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "optionalDependencies": {
    "playwright": "^1.47.0"
  }
}
