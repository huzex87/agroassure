{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "types": ["node"]
  },
  // tools/ is deliberately out: it holds the demo seeder, which imports
  // field-core to author events the way a handset does. That belongs in a
  // development checkout, not in the image the service ships as.
  "include": ["src/**/*.ts"]
}
